# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Admin
AUTH_SECRET="replace-with-a-secure-random-32-character-secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-secure-admin-password"


# Supabase & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="product-images"

# Testing & E2E Overrides (strictly ignored when NODE_ENV=production)
# DISABLE_OPERATING_HOURS="true"
# APP_ENV="test"

# Meta WhatsApp Cloud API (Sipariş Bildirimleri)
WHATSAPP_ENABLED="false"
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_RECIPIENT_PHONE=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_COOLDOWN_SECONDS="180"
WHATSAPP_MONTHLY_LIMIT="850"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Admin
AUTH_SECRET="replace-with-a-secure-random-32-character-secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-secure-admin-password"


# Image storage / external services
# IMAGE_STORAGE_URL=""
# IMAGE_STORAGE_KEY=""
# IMAGE_STORAGE_SECRET=""

# Testing & E2E Overrides (strictly ignored when NODE_ENV=production)
# DISABLE_OPERATING_HOURS="true"
# APP_ENV="test"
